{
  "name": "vendorscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <27"
  },
  "scripts": {
    "build": "tsc && esbuild web/app.ts --bundle --outfile=web/app.js --target=es2024",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "node --import tsx --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test test/*.test.ts",
    "start": "python -m app.cli serve",
    "demo": "python -m app.cli demo",
    "verify": "npm run lint && npm run typecheck && npm run coverage && npm run build && npm run demo",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "@biomejs/biome": "2.6.4",
    "esbuild": "0.28.2",
    "@playwright/test": "1.64.1"
  }
}
